{
  "image": "infographic.png",
  "layout": "layout.json",
  "output": { "file": "out/qsofa_test_9x16.mp4", "size": [1080, 1920], "fps": 30 },
  "subtitle_style": { "size": 52, "chars_per_line": 16, "y": 0.80 },
  "bgm": { "synth": "soft_pad", "volume": 0.10 },
  "tail": 1.6,

  "narration": {
    "lead_in": 0.7, "gap": 0.4, "speed": 1.3,
    "segments": [
      { "id": "n1", "speak": "敗血症を見逃さないための、クイックソーファを、おさらいしましょう。", "subtitle": "敗血症を見逃さないための\nqSOFAをおさらいしましょう", "subtitle_y": 0.70 },
      { "id": "n2", "speak": "ひとつめは、呼吸数。1分間に、22回以上なら、要注意です。", "subtitle": "①呼吸数\n1分間に22回以上なら要注意" },
      { "id": "n3", "speak": "ふたつめは、意識の変容。いつもと違う、は、大切なサインです。", "subtitle": "②意識の変容\n「いつもと違う」は大切なサイン" },
      { "id": "n4", "speak": "みっつめは、収縮期血圧。100ミリエイチジー以下に、注目します。", "subtitle": "③収縮期血圧\n100mmHg以下に注目" },
      { "id": "n5", "speak": "2項目以上あてはまれば、敗血症を疑い、すぐに医師へ報告しましょう。", "subtitle": "2項目以上で敗血症を疑い\nすぐに医師へ報告！", "subtitle_y": 0.47 }
    ]
  },

  "camera": [
    { "at": 0,               "focus": "full", "pad": 0, "move": 0, "drift": 0.05 },
    { "at": "n2.start-0.7",  "focus": "c1",   "pad": 20, "move": 1.8 },
    { "at": "n3.start-0.7",  "focus": "c2",   "pad": 20, "move": 1.5 },
    { "at": "n4.start-0.7",  "focus": "c3",   "pad": 20, "move": 1.5 },
    { "at": "n5.start-0.3",  "focus": "full", "pad": 0,  "move": 2.0 }
  ],

  "overlays": [
    { "type": "pointer",   "target": "title",    "start": "n1.start+0.3", "dur": 0.4, "until": "n2.start-0.8", "color": "yellow" },

    { "type": "highlight", "target": "c1_value", "sync": "n2", "from": 0.30, "to": 0.80, "color": "yellow", "sfx": "pen" },
    { "type": "underline", "target": "c1_value", "sync": "n2", "from": 0.80, "to": 0.95, "color": "red", "offset": 12 },

    { "type": "circle",    "target": "c2_label", "sync": "n3", "from": 0.05, "to": 0.35, "color": "green", "pad": 22, "sfx": "pop" },
    { "type": "highlight", "target": "c2_note",  "sync": "n3", "from": 0.45, "to": 0.90, "color": "yellow" },

    { "type": "highlight", "target": "c3_value", "sync": "n4", "from": 0.40, "to": 0.85, "color": "yellow", "sfx": "pen" },
    { "type": "underline", "target": "c3_value", "sync": "n4", "from": 0.85, "to": 0.98, "color": "red", "offset": 12 },

    { "type": "arrow", "from": [540, 935], "to": [540, 1525], "bend": 0, "start": "n5.start+0.2", "dur": 0.9, "color": "red", "width": 12, "sfx": "swoosh" },
    { "type": "box",   "target": "concl", "pad": 14, "start": "n5.start+0.9", "dur": 1.1, "color": "blue", "width": 12, "sfx": "pop" },
    { "type": "pulse", "target": "concl_2", "pad": 12, "start": "n5.mid", "dur": 2.6, "color": "orange", "sfx": "ding" }
  ],

  "fade": { "in": 0.4, "out": 0.6 }
}
